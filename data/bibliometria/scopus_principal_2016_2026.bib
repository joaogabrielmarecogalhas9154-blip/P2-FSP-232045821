	year = {2026},
	journal = {Economic Analysis and Policy},
	volume = {92},
	pages = {518 - 544},
	doi = {10.1016/j.eap.2026.06.029},
	url = {https://www.scopus.com/pages/publications/105041899087?origin=resultslist},
	affiliations = {University of Szczecin, Poland; Maria Curie-Sklodowska University in Lublin, Poland; University of Bialystok, Poland},
	abstract = {This study examines how the assignment, fiscal importance and institutional design of personal income tax (PIT) revenues are associated with the fiscal condition of local governments in OECD countries. While PIT plays an important role in intergovernmental finance, existing research rarely distinguishes between alternative forms of PIT decentralization that differ in fiscal importance and the degree of local tax autonomy. This paper addresses this gap by conceptualizing PIT decentralization along three dimensions: institutional participation in PIT revenues, the changing fiscal importance of PIT within local revenue systems, and tax autonomy embedded in institutional design. Using cross-country panel evidence from up to 29 OECD countries over 2007–2023, the analysis examines how these dimensions relate to local debt dynamics, investment expenditure shares, and reliance on intergovernmental transfers. The results indicate that the mere assignment of PIT revenues to local governments is not systematically associated with debt outcomes. By contrast, increases in the fiscal importance of PIT within countries are associated with lower debt ratios, while structurally higher PIT shares are associated with higher average debt levels, suggesting that stable own-source revenues may also support borrowing capacity. Greater PIT importance is not systematically associated with lower transfer dependence in the baseline models, but a clearer negative relationship emerges in institutional regimes characterized by meaningful tax autonomy, particularly piggyback and autonomous local PIT systems. For investment, the evidence is weaker and is more consistent with changes in expenditure composition than with differences in investment capacity in absolute terms. The findings suggest that the fiscal relevance of PIT decentralization depends less on formal revenue assignment alone than on fiscal importance, tax autonomy, and marginal revenue retention. From a policy perspective, decentralization reforms are more likely to strengthen local fiscal independence when revenue autonomy is aligned with broader fiscal governance arrangements. © 2026 The Economic Society of Australia (Queensland) Inc.},
	author_keywords = {Fiscal decentralization; Fiscal sustainability; PIT decentralization models; Tax autonomy},
	correspondence_address = {S. Franek; University of Szczecin, Poland; email: slawomir.franek@usz.edu.pl},
	publisher = {Elsevier B.V.},
	issn = {03135926},
	language = {English},
	abbrev_source_title = {Econ. Anal. Policy},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

