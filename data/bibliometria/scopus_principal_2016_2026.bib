	title = {Fiscal Competition, Intergovernmental Transfer, and Local Debt Management},
	year = {2026},
	journal = {Public Performance and Management Review },
	pages = {},
	doi = {10.1080/15309576.2026.2723015},
	url = {https://www.scopus.com/pages/publications/105049263972?origin=resultslist},
	affiliations = {Renmin University of China, China; Dongguan University of Technology, China; University of North Texas, United States},
	abstract = {This study examines how tax and expenditure competition, two distinct yet complementary mechanisms of horizontal fiscal governance, affect local debt management in China’s local government bond market, using a two-stage least squares (2SLS) approach. It further investigates the moderating role of intergovernmental transfers intended to promote fiscal stabilization and equalization. Drawing on panel data from 272 prefecture-level cities between 2010 and 2018, the results indicate that intensified tax and expenditure competition significantly increases local government debt, while intergovernmental transfers reduce direct borrowing needs through a substitution effect but exacerbate debt accumulation under fiscal competitive pressure by weakening local fiscal discipline. The study contributes to the public management and performance literature by highlighting how fiscal governance can distort local managerial incentives and undermine local debt management. © 2026 Taylor & Francis Group, LLC.},
	author_keywords = {fiscal competition; fiscal governance; intergovernmental transfer; local government debt},
	correspondence_address = {Y. Shi; Department of Public Administration, School of Public Affairs, University of North Texas, Denton, 1155 Union Circle #310617, 76201, United States; email: yu.shi@unt.edu},
	publisher = {Routledge},
	issn = {15309576},
	language = {English},
	abbrev_source_title = {Public Perform. Manage. Rev.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

