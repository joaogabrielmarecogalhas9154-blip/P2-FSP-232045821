	author = {Guziejewska, Beata},
	title = {A comparative approach to fiscal illusions: A synthesis of the conclusions from a polish study in relation to new ideas and empirical research in selected countries; [Iluzje fiskalne w ujęciu porównawczym: synteza wyników badań w Polsce na tle nowych podejść i badań empirycznych wybranych krajów]},
