@ARTICLE{Jin202053,
	author = {Jin, Ge and Lin, Yanfang},
	title = {Growth with Optimal Intergovernmental Transfers: Based on Spatial Externalities of Local Public Services},
	year = {2020},
	journal = {China Journal of Economics},
	volume = {7},
	number = {3},
	pages = {53 - 84},
	url = {https://www.scopus.com/pages/publications/85151139039?origin=resultslist},
	affiliations = {School of Public Finance and Taxation, Zhejiang University of Finance and Economics, China; School of Economics, Fudan University, China},
	abstract = {In this paper we develop an endogenous growth model with a three-stage Stackelberg game among a central government, two local governments and two representative agents. Considering the pervasive interregional spatial externalities of local public services in reality, we focus on the optimal transfers of the central government and the optimal expenditures of the local governments. Specifically, we analyze the optimal transfers of the central government and the corresponding optimal income taxes and public expenditures of the local governments in a decentralized economy with income taxes. There are four main findings as follows. Firstly, the optimal transfer from the central government to a local government is positively correlated with the output elasticity of the local public services to its neighboring region while negatively related with that to the region itself. Secondly, there is a tax wedge between the second-best optimal transfers and the best optimal transfers. Thirdly, if the local public services only affect production directly, the ratio of the optimal local public expenditure to output is equal to the sum of the output elasticity of the local public services to the locality and neighboring region, and this conclusion is irrelevant to whether the government levies income taxes or lump-sum taxes. Finally, if the local public services affect utility directly as well as production, and meanwhile have consumption externalities on the agents of adjacent areas, the central government is required to adopt a higher transfer rate as well as a higher income tax rate. © 2020, Tsinghua University Press. All rights reserved.},
	publisher = {Tsinghua University Press},
	issn = {20957254},
	language = {Chinese},
	abbrev_source_title = {Ch. J. Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

