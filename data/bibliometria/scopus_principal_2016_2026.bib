	language = {English},
	abbrev_source_title = {J. Public Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@ARTICLE{Kammas2023,
	author = {Kammas, Pantelis and Poulima, Maria and Sarantides, Vassilis},
	title = {Fueling the party machine: Evidence from Greece during Metapolitefsi},
	year = {2023},
	journal = {Explorations in Economic History},
	volume = {90},
	pages = {},
	doi = {10.1016/j.eeh.2023.101538},
	url = {https://www.scopus.com/pages/publications/85162919214?origin=resultslist},
	affiliations = {Department of International and European Economic Studies, Athens University of Economics and Business, Patission 76 Street, Athens, 10434, Greece; Department of Economics, University of Ioannina, P.O. Box 1186, Ioannina, 45110, Greece; Department of Economics, Athens University of Economics and Business, Patission 76 Street, Athens, 10434, Greece},
	abstract = {The establishment of the Third Hellenic Republic in 1974 (Metapolitefsi) was characterized by an increased public demand for a less centralized political system. The main political parties that emerged responded by giving priority to the development of local and regional organizations and creating a wide network of grassroots movements. This led to a gradual introduction of more decentralized political institutions and a significant increase of expenses to prefectures and subsidies to municipalities. Building on two novel hand-collected datasets at the prefectural and municipal levels, our analysis provides empirical evidence of party favoritism in the spatial allocation of intergovernmental transfers during the first two decades of Metapolitefsi. We argue that governing parties diverted intergovernmental transfers towards their political strongholds and politically aligned mayors, as local authorities played the role of the focal points in the process of party building. © 2023 Elsevier Inc.},
	author_keywords = {clientelistic networks; intergovernmental transfers; party machine},
	correspondence_address = {V. Sarantides; Department of Economics, Athens University of Economics and Business, Athens, Patission 76 Street, 10434, Greece; email: v.sarantides@aueb.gr},
	publisher = {Academic Press Inc.},
	issn = {00144983},
	language = {English},
	abbrev_source_title = {Explor. Econ. Hist.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

