}

@ARTICLE{Makreshanska-Mladenovska2019123,
	author = {Makreshanska-Mladenovska, Suzana and Petrevski, Goran},
	title = {Decentralisation and income inequality in Central and Eastern European countries},
	year = {2019},
	journal = {Post-Communist Economies},
	volume = {31},
	number = {1},
	pages = {123 - 136},
	doi = {10.1080/14631377.2018.1461526},
	url = {https://www.scopus.com/pages/publications/85048140536?origin=resultslist},
	affiliations = {Faculty of Economics, Saints Cyril and Methodius University, Skopje, North Macedonia},
	abstract = {This paper provides empirical evidence for the association between fiscal decentralisation and income distribution for a panel of 11 economies from Central and Eastern Europe (CEE) during 1992–2016. We focus on three research topics: the effect of decentralisation on income inequality; the effects of the structure of subnational government finance on income inequality; and the validity of the Kuznets hypothesis. The main findings from the empirical exercise are as follows: first, we provide firm evidence on the presumed favourable effects of fiscal decentralisation on income distribution in the CEE countries; second, our empirical model suggests that the effects of fiscal decentralisation on income inequality are dependent on the source of finance of subnational governments, i.e. intergovernmental transfers may have a role in income equalisation; third, we cannot confirm the validity of the Kuznets hypothesis in CEE countries. © 2018, © 2018 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {Central and Eastern Europe; Fiscal decentralisation; fiscal transfers; inequality; panel data models},
	keywords = {Central Europe; Eastern Europe; decentralization; empirical analysis; finance; fiscal policy; income distribution; Kuznets curve; numerical model; panel data},
