	url = {https://www.scopus.com/pages/publications/105018622284?origin=resultslist},
	affiliations = {National Institute of Public Finance and Policy, New Delhi, India},
	abstract = {The finances of 166 municipal corporations across 22 states for 2019–20 to 2021–22 are analysed. While data availability has improved, comparability issues remain. Indicators examined include own revenue, dependence on intergovernmental transfers, coverage of expenditure from own revenues, and capital receipts. MCs are heterogeneous: smaller MCs rely heavily on transfers, whereas larger MCs primarily depend on own revenues. On average, own revenues finance 51%–56% of revenue expenditure, with property tax as the main levy. High transfer dependence discourages local revenue mobilisation, underscoring the need for policy frameworks to strengthen MCs and build vibrant urban growth centres. © 2025, Economic and Political Weekly. All rights reserved.},
